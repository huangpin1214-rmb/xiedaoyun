{"type":"message","id":"3b2fa24b","parentId":"b72c8fd0","timestamp":"2026-04-05T08:42:50.497Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Wait, there's a problem with using `${RESULT}` inside a Python heredoc. The shell will expand it before Python sees it. I need to use environment variables or a different approach. Let me rewrite this to pass data through environment variables.","thinkingSignature":"43f2a758882eee2a71be6a96e8ddc12baf699f2178d892acdefc256a886417e8"},{"type":"toolCall","id":"call_function_fob0v9ewfrjz_1","name":"write","arguments":{"path":"/Users/edy/.openclaw/workspace/scripts/getnote-sprout-push.sh","content":"#!/bin/bash\n# getnote-sprout-push.sh - 每天发芽内容推送\n# 使用方法: crontab: 30 21 * * * /Users/edy/.openclaw/workspace/scripts/getnote-sprout-push.sh\n\nWORKSPACE=\"$HOME/.openclaw/workspace\"\nLOG_FILE=\"$WORKSPACE/.backup.log\"\nDATE=$(date +%Y-%m-%d)\n\necho \"🌱 开始发芽推送... $DATE\"\n\n# ===== 读取 Get笔记 配置 =====\nCONFIG_FILE=\"$HOME/.openclaw/openclaw.json\"\n\nGETNOTE_API_KEY=$(python3 -c \"\nimport json\nwith open('$CONFIG_FILE') as f:\n    d = json.load(f)\n    entries = d.get('skills', {}).get('entries', {})\n    getnote = entries.get('getnote', {})\n    print(getnote.get('apiKey', ''))\n\" 2>/dev/null)\n\nGETNOTE_CLIENT_ID=$(python3 -c \"\nimport json\nwith open('$CONFIG_FILE') as f:\n    d = json.load(f)\n    entries = d.get('skills', {}).get('entries', {})\n    getnote = entries.get('getnote', {})\n    env = getnote.get('env', {})\n    print(env.get('GETNOTE_CLIENT_ID', ''))\n\" 2>/dev/null)\n\nif [ -z \"$GETNOTE_API_KEY\" ] || [ -z \"$GETNOTE_CLIENT_ID\" ]; then\n    echo \"❌ Get笔记 API Key 未配置，跳过推送\"\n    exit 1\nfi\n\n# ===== 获取发芽报告 =====\necho \"📡 搜索最近发芽报告...\"\n\nRESULT=$(curl -s -X POST \"https://openapi.biji.com/open/api/v1/resource/recall\" \\\n    -H \"Content-Type: application/json; charset=utf-8\" \\\n    -H \"Authorization: $GETNOTE_API_KEY\" \\\n    -H \"X-Client-ID: $GETNOTE_CLIENT_ID\" \\\n    -d '{\"query\":\"发芽报告 教育 亲子 孩子学习\",\"top_k\":3}')\n\n# 保存结果到临时文件（避免shell变量编码问题）\necho \"$RESULT\" > /tmp/getnote_sprout_result.json\n\n# ===== Python处理并发送 =====\npython3 << 'PYEOF'\n# -*- coding: utf-8 -*-\nimport subprocess, json, sys, os, datetime\n\nRESULT_FILE = \"/tmp/getnote_sprout_result.json\"\n\ntry:\n    with open(RESULT_FILE, 'r', encoding='utf-8') as f:\n        RESULT = f.read()\n    \n    data = json.loads(RESULT)\n    results = data.get('data', {}).get('results', [])\n    \n    if not results:\n        print(\"📭 今日暂无发芽内容\")\n        sys.exit(0)\n    \n    # 取第一条\n    r = results[0]\n    title = r.get('title', '无标题')\n    content = r.get('content', '')\n    created = r.get('created_at', '')\n    \n    # 截取内容前600字\n    if len(content) > 600:\n        content = content[:600] + '...'\n    \n    # 清理换行\n    content = re.sub(r'\\n+', ' ', content)\n    title = re.sub(r'\\n+', ' ', title)\n    \n    print(f\"📝 找到发芽报告: {title}\")\n    \n    # ===== 发送飞书推送 =====\n    APP_ID = \"cli_a93534f5edb85bd3\"\n    CONFIG_FILE = os.path.expanduser(\"~/.openclaw/openclaw.json\")\n    with open(CONFIG_FILE) as f:\n        feishu_cfg = json.load(f).get(\"channels\", {}).get(\"feishu\", {})\n    APP_SECRET = feishu_cfg.get(\"appSecret\", \"\")\n    USER_OPEN_ID = \"ou_2ad19bb3863e71e2d0eff5cc4aeedd83\"\n\n    result = subprocess.run(\n        [\"curl\", \"-s\", \"-X\", \"POST\",\n         \"https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal\",\n         \"-H\", \"Content-Type: application/json\",\n         \"-d\", json.dumps({\"app_id\": APP_ID, \"app_secret\": APP_SECRET})],\n        capture_output=True, text=True\n    )\n    token_data = json.loads(result.stdout)\n    app_token = token_data.get(\"tenant_access_token\", \"\")\n\n    if not app_token:\n        print(\"获取 token 失败，跳过推送\")\n        sys.exit(0)\n\n    msg = f\"\"\"🌱 每日发芽 | {created}\n\n📌 {title}\n\n{content}\n\n---\n💡 来自 Get笔记 · 每日学习复盘\"\"\"\n\n    subprocess.run(\n        [\"curl\", \"-s\", \"-X\", \"POST\",\n         \"https://open.feishu.cn/open-apis/im/v1/messages?receive_id_type=open_id\",\n         \"-H\", f\"Authorization: Bearer {app_token}\",\n         \"-H\", \"Content-Type: application/json; charset=utf-8\",\n         \"-d\", json.dumps({\n             \"receive_id\": USER_OPEN_ID,\n             \"msg_type\": \"text\",\n             \"content\": json.dumps({\"text\": msg}, ensure_ascii=False)\n         }, ensure_ascii=False)],\n        capture_output=True\n    )\n    print(\"🌱 发芽推送已发送\")\n    \nexcept Exception as e:\n    print(f\"错误: {e}\")\n    import traceback\n    traceback.print_exc()\n    sys.exit(1)\nPYEOF\n\n# 清理临时文件\nrm -f /tmp/getnote_sprout_result.json\n\necho \"✅ 发芽推送完成: $(date)\" | tee -a \"$LOG_FILE\"\n"}}],"api":"anthropic-messages","provider":"minimax","model":"MiniMax-M2.7","usage":{"input":136018,"output":1293,"cacheRead":39291,"cacheWrite":0,"totalTokens":176602,"cost":{"input":0.0408054,"output":0.0015516,"cacheRead":0.0023574599999999996,"cacheWrite":0,"total":0.04471446}},"stopReason":"toolUse","timestamp":1775378553130,"responseId":"06215379a7f60441262de439370f9d7f"}}
