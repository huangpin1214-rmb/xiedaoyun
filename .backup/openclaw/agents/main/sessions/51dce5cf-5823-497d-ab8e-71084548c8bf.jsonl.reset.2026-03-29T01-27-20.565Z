{"type":"message","id":"c8c1fbcc","parentId":"73a7c864","timestamp":"2026-03-29T00:57:10.271Z","message":{"role":"toolResult","toolCallId":"call_function_0ku98wp2sez0_1","toolName":"exec","content":[{"type":"text","text":"4037:\treturn { text: \"🔊 **TTS (Text-to-Speech) Help**\\n\\n**Commands:**\\n• /tts on — Enable automatic TTS for replies\\n• /tts off — Disable TTS\\n• /tts status — Show current settings\\n• /tts provider [name] — View/change provider\\n• /tts limit [number] — View/change text limit\\n• /tts summary [on|off] — View/change auto-summary\\n• /tts audio <text> — Generate audio from text\\n\\n**Providers:**\\n• microsoft — Microsoft Edge-backed speech (default fallback)\\n• openai — High quality (requires API key)\\n• elevenlabs — Premium voices (requires API key)\\n\\n**Text Limit (default: 1500, max: 4096):**\\nWhen text exceeds the limit:\\n• Summary ON: AI summarizes, then generates audio\\n• Summary OFF: Truncates text, then generates audio\\n\\n**Examples:**\\n/tts provider microsoft\\n/tts limit 2000\\n/tts audio Hello, this is a test!\" };\n4094:\t\t\t\t\taudioAsVoice: result.voiceCompatible === true\n4116:\t\t\tconst hasMicrosoft = isTtsProviderConfigured(config, \"microsoft\", params.cfg);\n4119:\t\t\t\treply: { text: `🎙️ TTS provider\\nPrimary: ${currentProvider}\\nOpenAI key: ${hasOpenAI ? \"✅\" : \"❌\"}\\nElevenLabs key: ${hasElevenLabs ? \"✅\" : \"❌\"}\\nMicrosoft enabled: ${hasMicrosoft ? \"✅\" : \"❌\"}\\nUsage: /tts provider openai | elevenlabs | microsoft` }"}],"details":{"status":"completed","exitCode":0,"durationMs":20,"aggregated":"4037:\treturn { text: \"🔊 **TTS (Text-to-Speech) Help**\\n\\n**Commands:**\\n• /tts on — Enable automatic TTS for replies\\n• /tts off — Disable TTS\\n• /tts status — Show current settings\\n• /tts provider [name] — View/change provider\\n• /tts limit [number] — View/change text limit\\n• /tts summary [on|off] — View/change auto-summary\\n• /tts audio <text> — Generate audio from text\\n\\n**Providers:**\\n• microsoft — Microsoft Edge-backed speech (default fallback)\\n• openai — High quality (requires API key)\\n• elevenlabs — Premium voices (requires API key)\\n\\n**Text Limit (default: 1500, max: 4096):**\\nWhen text exceeds the limit:\\n• Summary ON: AI summarizes, then generates audio\\n• Summary OFF: Truncates text, then generates audio\\n\\n**Examples:**\\n/tts provider microsoft\\n/tts limit 2000\\n/tts audio Hello, this is a test!\" };\n4094:\t\t\t\t\taudioAsVoice: result.voiceCompatible === true\n4116:\t\t\tconst hasMicrosoft = isTtsProviderConfigured(config, \"microsoft\", params.cfg);\n4119:\t\t\t\treply: { text: `🎙️ TTS provider\\nPrimary: ${currentProvider}\\nOpenAI key: ${hasOpenAI ? \"✅\" : \"❌\"}\\nElevenLabs key: ${hasElevenLabs ? \"✅\" : \"❌\"}\\nMicrosoft enabled: ${hasMicrosoft ? \"✅\" : \"❌\"}\\nUsage: /tts provider openai | elevenlabs | microsoft` }","cwd":"/Users/edy/.openclaw/workspace"},"isError":false,"timestamp":1774745830267}}
