token,\n            size: fileSize,\n            file: fileBuffer,\n            extra: JSON.stringify({\n                bitablePerm: {\n                    tableId: p.table_id,\n                },\n            }),\n        },\n    }, opts), { as: 'user' });\n    const fileToken = uploadRes?.file_token ?? uploadRes?.data?.file_token;"}],"details":{"status":"completed","exitCode":0,"durationMs":11,"aggregated":"action: typebox_1.Type.Literal('bitable_upload'),\n        app_token: typebox_1.Type.String({\n            description: '多维表格的 app_token（必填）',\n        }),\n        table_id: typebox_1.Type.String({\n            description: '数据表的 table_id（必填）',\n        }),\n        field_id: typebox_1.Type.String({\n            description: '附件字段的 field_id（必填）',\n        }),\n        file_path: typebox_1.Type.String({\n            description: '本地文件的绝对路径（必填）。图片支持 jpg/png/gif/webp 等，文件支持任意格式，最大 20MB',\n        }),\n        type: typebox_1.Type.Optional((0, helpers_1.StringEnum)(['image', 'file'], {\n            description: '媒体类型：\"image\"（图片，默认）或 \"file\"（文件附件）',\n        })),\n    }),\n]);\n// ---------------------------------------------------------------------------\n// Action handlers\n// ---------------------------------------------------------------------------\nasync function handleInsert(p, client, log) {\n    const documentId = extractDocumentId(p.doc_id);\n    const mediaType = p.type ?? 'image';\n    const config = MEDIA_CONFIG[mediaType];\n    // 0. 路径白名单校验 — 仅允许 tmpdir 下的文件\n    const filePath = p.file_path;\n    const DOC_MEDIA_ALLOWED_ROOTS = [os.tmpdir()];\n    (0, media_url_utils_1.validateLocalMediaRoots)(path.resolve(filePath), DOC_MEDIA_ALLOWED_ROOTS);\n    // 1. 读取并校验本地文件\n    let fileSize;\n--\n    log.info(`bitable_upload: app=${p.app_token}, table=${p.table_id}, field=${p.field_id}, file=${fileName}, size=${fileSize}`);\n    // 读取文件内容作为 Buffer 传递\n    const fileBuffer = await fs.readFile(filePath);\n    const uploadRes = await client.invoke('feishu_do