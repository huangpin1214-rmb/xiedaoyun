-4e71-a11f-a72c0b2445b2.jpg;type=image/jpeg\" \\\n  -w \"\\nHTTP_CODE:%{http_code}\")\n\necho \"OSS Result: $OSS_RESULT\""}}],"api":"anthropic-messages","provider":"minimax","model":"MiniMax-M2.7","usage":{"input":69539,"output":582,"cacheRead":40516,"cacheWrite":0,"totalTokens":110637,"cost":{"input":0.0208617,"output":0.0006984,"cacheRead":0.00243096,"cacheWrite":0,"total":0.023991059999999998}},"stopReason":"toolUse","timestamp":1775696641928,"responseId":"06262e0249b02e9493bb72a41db863ff"}}
