(cursor_id):\n    url = f\"https://openapi.biji.com/open/api/v1/resource/note/list?since_id={cursor_id}\"\n    r = subprocess.run([\"curl\", \"-s\", url], capture_output=True, text=True, headers=headers)\n    text = r.stdout\n    # 大整数处理\n    safe = re.sub(r'\"(id|note_id|next_cursor|parent_id|follow_id|live_id)\"\\s*:\\s*(\\d+),', r'\"\\1\":\"\\2\",', text)\n    # 移除控制字符\n    safe = re.sub(r'[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]', '', safe)\n    try:\n        data = json.loads(safe)\n        return data.get('data', {})\n    except:\n        return {}\n\ndef add_to_kb(topic_id, note_ids):\n    if not note_ids:\n        return 0\n    url = \"https://openapi.biji.com/open/api/v1/resource/knowledge/note/batch-add\"\n    payload = json.dumps({\"topic_id\": topic_id, \"note_ids\": note_ids})\n    r = subprocess.run([\"curl\", \"-s\", \"-X\", \"POST\", url, \"-H\", \"Content-Type: application/json\",\n                        \"-d\", payload], capture_output=True, text=True, headers=headers)\n    try:\n        d = json.loads(r.stdout)\n        if d.get('success'):\n            return d.get('data', {}).get('success_count', 0)\n    except:\n        pass\n    return 0\n\ndef classify(title, ntype):\n    if not title and ntype != 'plain_text':\n        return None\n    t = title.lower()\n    if any(k in t for k in ['芯片','半导体','中美','美国','制裁','出口管','实体清单','光刻','大模型','模型','算力','nvidia','英伟达','华为']):\n        return 'CHIP'\n    if any(k in t for k in ['中考','高考','分数','志愿','成都','入学','学校','高中','初中','学习','教育','孩子','英语','数学','语文','补习']):\n        return 'EDU'\n    if any(k in t for k in ['openclaw','prompt','提示词','ai工具','工作流']):\n        return 'OC'\n    if title:\n        return 'EDU'  # 有标题的先归教育，后续可调整\n    return None\n\nwhile True:\n    batch += 1\n    data = fetch_notes(cursor)\n    notes = data.get('notes', [])\n    has_more = data.get('has_more', False)\n    next_cursor = data.get('next_cursor', '')\n    \n    chip_ids, edu_ids, oc_ids = [], [], []\n    chip_cnt, edu_cnt, oc_cnt = 0, 0, 0\n    \n    skip_prefixes = ['每日备份报告', '每日复盘', '每日发芽报告']\n    \n    for n in notes:\n        title = n.get('title', '') or ''\n        if any(title.startswith(p) for p in skip_prefixes):\n            continue\n        ntype = n.get('note_type', '?')\n        cat = classify(title, ntype)\n        nid = n['id']\n        if cat == 'CHIP':\n            chip_ids.append(nid)\n        elif cat == 'EDU':\n            edu_ids.append(nid)\n        elif cat == 'OC':\n            oc_ids.append(nid)\n    \n    migrated_this = 0\n    migrated_this += add_to_kb(KB_CHIP, chip_ids)\n    migrated_this += add_to_kb(KB_EDU, edu_ids)\n    migrated_this += add_to_kb(KB_OC, oc_ids)\n    total_migrated += migrated_this\n    \n    print(f\"[Batch {batch}] Chip:{len(chip_ids)} Edu:{len(edu_ids)} OC:{len(oc_ids)} | +{migrated_this} | Total:{total_migrated} | has_more:{has_more} | next:{str(next_cursor)[:20]}\")\n    \n    cursor = next_cursor\n    if not has_more or not cursor or cursor == 'None':\n        print(f\"=== 全部完成! 总迁移: {total_migrated} ===\")\n        break\n    \n    time.sleep(0.5)\n\nPYEOF","name":"export GETNOTE_API_KEY=\"gk_li...919f4d657e7a15d91347a\"","tail":"Traceback (most recent call last):\n  File \"<stdin>\", line 63, in <module>\n  File \"<stdin>\", line 20, in fetch_notes\n  File \"/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/lib/python3.9/subprocess.py\", line 505, in run\n    with Popen(*popenargs, **kwargs) as process:\nTypeError: __init__() got an unexpected keyword argument 'headers'\n","truncated":false,"exitCode":1},{"sessionId":"faint-sage","status":"failed","startedAt":1775689155753,"endedAt":1775689413956,"runtimeMs":258203,"cwd":"/Users/edy/.openclaw/workspace","command":"export GETNOTE_API_KEY=\"gk_live_79414cc5d34021a6.f48b009c9ed9470d05fbec8f4ef919f4d657e7a15d91347a\"\nexport GETNOTE_CLIENT_ID=\"cli_a1b2c3d4e5f6789012345678abcdef90\"\n\nKB_CHIP=\"9YeBam0m\"\nKB_EDU=\"EJX1r7bn\"\nKB_OC=\"G0P1Z51J\"\n\ncursor=