import sys, json, re\ntext = sys.stdin.read()\nsafe = re.sub(r'\\\"(id|note_id|next_cursor|parent_id|follow_id|live_id)\\\"\\s*:\\s*(\\d+),', r'\\\"\\1\\\":\\\"\\2\\\",', text)\ntry:\n    data = json.loads(safe)\n    notes = data.get('data', {}).get('notes', [])\n    has_more = data.get('data', {}).get('has_more', False)\n    next_cursor = data.get('data', {}).get('next_cursor', '')\n    print(f'HAS_MORE={has_more}|NEXT={next_cursor}')\n    for n in notes:\n        title = n.get('title', '') or ''\n        skip_prefixes = ['每日备份报告', '每日复盘', '每日发芽报告']\n        if any(title.startswith(p) for p in skip_prefixes):\n            print(f'SKIP')\n            continue\n        if title or n.get('note_type') == 'plain_text':\n            nid = n['id']\n            ntype = n.get('note_type','?')\n            # 简单分类\n            nlower = title.lower()\n            if any(k in nlower for k in ['芯片','半导体','中美','美国','制裁','出口管','实体清单','光刻','ai ','大模型','模型','算力','nvidia','英伟达','华为','中美贸']):\n                cat='CHIP'\n            elif any(k in nlower for k in ['中考','高考','分数','志愿','成都','入学','学校','高中','初中','学习','教育','孩子','英语','数学','语文','补习']):\n                cat='EDU'\n            elif any(k in nlower for k in ['openclaw','prompt','提示词','ai工具','工作流']):\n                cat='OC'\n            else:\n                cat='OTHER'\n            print(f'KEEP|{nid}|{title[:40]}|{ntype}|{cat}')\n        else:\n            print(f'SKIP')\nexcept Exception as e:\n    print(f'ERROR:{e}')\n    sys.exit(1)\n\")\n  \n  has_more=$(echo \"$result\" | python3 -c \"\nimport sys, json, re\ntext = sys.stdin.read()\nsafe = re.sub(r'\\\"(id|note_id|next_cursor|parent_id|follow_id|live_id)\\\"\\s*:\\s*(\\d+),', r'\\\"\\1\\\":\\\"\\2\\\",', text)\ndata = json.loads(safe)\nprint(data.get('data', {}).get('has_more', False))\n\")\n  \n  next_cursor=$(echo \"$result\" | python3 -c \"\nimport sys, json, re\ntext = sys.stdin.read()\nsafe = re.sub(r'\\\"(id|note_id|next_cursor|parent_id|follow_id|live_id)\\\"\\s*:\\s*(\\d+),', r'\\\"\\1\\\":\\\"\\2\\\",', text)\ndata = json.loads(safe)\nprint(data.get('data', {}).get('next_cursor', ''))\n\")\n  \n  # 提取本批待迁移的ID\n  chip_ids=$(echo \"$safe\" | grep 'KEEP' | grep '|CHIP|' | cut -d'|' -f3)\n  edu_ids=$(echo \"$safe\" | grep 'KEEP' | grep '|EDU|' | cut -d'|' -f3)\n  oc_ids=$(echo \"$safe\" | grep 'KEEP' | grep '|OC|' | cut -d'|' -f3)\n  \n  chip_count=$(echo \"$chip_ids\" | grep -c '^' || echo 0)\n  edu_count=$(echo \"$edu_ids\" | grep -c '^' || echo 0)\n  oc_count=$(echo \"$oc_ids\" | grep -c '^' || echo 0)\n  \n  migrated_this=0\n  \n  # 迁移芯片\n  if [ -n \"$chip_ids\" ]; then\n    ids_json=$(echo \"$chip_ids\" | python3 -c \"import sys,json; print(json.dumps([x for x in sys.stdin.read().strip().split('\\n') if x]))\")\n    if [ \"$chip_count\" -gt 0 ]; then\n      resp=$(curl -s -X POST \"https://openapi.biji.com/open/api/v1/resource/knowledge/note/batch-add\" \\\n        -H \"Authorization: $GETNOTE_API_KEY\" \\\n        -H \"X-Client-ID: $GETNOTE_CLIENT_ID\" \\\n        -H \"Content-Type: application/json\" \\\n        -d \"{\\\"topic_id\\\":\\\"$KB_CHIP\\\",\\\"note_ids\\\":$ids_json}\")\n      success=$(echo \"$resp\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('data',{}).get('success_count',0))\" 2>/dev/null || echo 0)\n      migrated_this=$((migrated_this+success))\n    fi\n  fi\n  \n  # 迁移教育\n  if [ -n \"$edu_ids\" ]; then\n    ids_json=$(echo \"$edu_ids\" | python3 -c \"import sys,json; print(json.dumps([x for x in sys.stdin.read().strip().split('\\n') if x]))\")\n    if [ \"$edu_count\" -gt 0 ]; then\n      resp=$(curl -s -X POST \"https://openapi.biji.com/open/api/v1/resource/knowledge/note/batch-add\" \\\n        -H \"Authorization: $GETNOTE_API_KEY\" \\\n        -H \"X-Client-ID: $GETNOTE_CLIENT_ID\" \\\n        -H \"Content-Type: application/json\" \\\n        -d \"{\\\"topic_id\\\":\\\"$KB_EDU\\\",\\\"note_ids\\\":$ids_json}\")\n      success=$(echo \"$resp\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('data',{}).get('success_count',0))\" 2>/dev/null || echo 0)\n      migrated_this=$((migrated_this+success))\n    fi\n  fi\n  \n  # 迁移OpenClaw\n  if [ -n \"$oc_ids\" ]; then\n    ids_json=$(echo \"$oc_ids\" | python3 -c \"import sys,json; print(json.dumps([x for x in sys.stdin.read().strip().split('\\n') if x]))\")\n    if [ \"$oc_count\" -gt 0 ]; then\n      resp=$(curl -s -X POST \"https://openapi.biji.com/open/api/v1/resource/knowledge/note/batch-add\" \\\n        -H \"Authorization: $GETNOTE_API_KEY\" \\\n        -H \"X-Client-ID: $GETNOTE_CLIENT_ID\" \\\n        -H \"Content-Type: application/json\" \\\n        -d \"{\\\"topic_id\\\":\\\"$KB_OC\\\",\\\"note_ids\\\":$ids_json}\")\n      success=$(echo \"$resp\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('data',{}).get('success_count',0))\" 2>/dev/null || echo 0)\n      migrated_this=$((migrated_this+success))\n    fi\n  fi\n  \n  total_migrated=$((total_migrated+migrated_this))\n  \n  echo \"[Batch $batch] Chip:$chip_count Edu:$edu_count OC:$oc_count | Migrated:$migrated_this | Total:$total_migrated | Next:$next_cursor\"\n  \n  cursor=\"$next_cursor\"\n  \n  if [ \"$has_more\" = \"False\" ] || [ -z \"$cursor\" ] || [ \"$cursor\" = \"None\" ]; then\n    echo \"=== 全部完成！ ===\"\n    echo \"TOTAL_MIGRATED=$total_migrated\"\n    break\n  fi\n  \n  sleep 0.5\ndone","name":"export GETNOTE_API_KEY=\"gk_li...919f4d657e7a15d91347a\"","tail":"Traceback (most recent call last):\n  File \"<string>\", line 5, in <module>\n  File \"/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/lib/python3.9/json/__init__.py\", line 346, in loads\n    return _default_decoder.decode(s)\n  File \"/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/lib/python3.9/json/decoder.py\", line 337, in decode\n    obj, end = self.raw_decode(s, idx=_w(s, 0).end())\n  File \"/Library/Developer/CommandLineTools/Library/Framewor