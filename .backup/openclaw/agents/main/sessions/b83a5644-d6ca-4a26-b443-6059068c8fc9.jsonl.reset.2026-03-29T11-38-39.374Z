niMax-M2.7","usage":{"input":63635,"output":563,"cacheRead":30966,"cacheWrite":0,"totalTokens":95164,"cost":{"input":0.0190905,"output":0.0006755999999999999,"cacheRead":0.0018579599999999999,"cacheWrite":0,"total":0.021624059999999997}},"stopReason":"toolUse","timestamp":1774775752091,"responseId":"061820c8030ab5dc3e55fc75552bf6b2"}}
