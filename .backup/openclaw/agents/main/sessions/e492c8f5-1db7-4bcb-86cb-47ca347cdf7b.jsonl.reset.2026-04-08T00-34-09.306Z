:30]:\n        types_str = '/'.join(info['types'])\n        print(f'  {name} ({info[\"count\"]}次) [{types_str}]')\nelse:\n    print('Error:', data)\nPYEOF"}}],"api":"anthropic-messages","provider":"minimax","model":"MiniMax-M2.7","usage":{"input":9106,"output":604,"cacheRead":40516,"cacheWrite":0,"totalTokens":50226,"cost":{"input":0.0027318,"output":0.0007247999999999999,"cacheRead":0.00243096,"cacheWrite":0,"total":0.00588756}},"stopReason":"toolUse","timestamp":1775522444418,"responseId":"0623858c9d8927578810f362e81d35a5"}}
