            '-H', 'X-Client-ID: cli_a1b2c3d4e5f6789012345678abcdef90',\n            '-H', 'Content-Type: application/json',\n            '-d', payload\n        ], capture_output=True, text=True)\n        \n        try:\n            data = json.loads(result.stdout)\n            if data.get('success'):\n                print(f\"✓ {kbname}: 迁入 {len(batch)} 篇\")\n            else:\n                print(f\"✗ {kbname}: 失败 - {data.get('error')}\")\n        except:\n            print(f\"✗ {kbname}: 解析错误\")\n        \n        time.sleep(0.5)\n\nprint(\"\\n全部完成!\")\nPYEOF","timeout":20}}],"api":"anthropic-messages","provider":"minimax","model":"MiniMax-M2.7","usage":{"input":93765,"output":784,"cacheRead":40516,"cacheWrite":0,"totalTokens":135065,"cost":{"input":0.028129499999999998,"output":0.0009408,"cacheRead":0.00243096,"cacheWrite":0,"total":0.031501259999999996}},"stopReason":"toolUse","timestamp":1775529485527,"responseId":"0623a10ed80e3de847829244e30d7f7b"}}
